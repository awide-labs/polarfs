FROM ubuntu:devel

# Install build dependencies and clean up in a single layer to reduce image size
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        make \
        git \
        ca-certificates \
        pkg-config \
        python3 \
        ruby-dev \
        libaio-dev \
        libfuse-dev \
        libgtest-dev \
        libssl-dev && \
    gem install fpm && \
    # Clean up apt cache and temporary files to reduce image size
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /polarfs
