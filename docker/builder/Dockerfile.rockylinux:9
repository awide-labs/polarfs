FROM rockylinux/rockylinux:9-minimal

# Install build dependencies and clean up in a single layer to reduce image size
RUN microdnf install -y dnf && \
    dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf install -y --enablerepo=devel --setopt=install_weak_deps=False \
        gcc \
        gcc-c++ \
        cmake \
        make \
        git \
        ca-certificates \
        python3 \
        ruby-devel \
        libaio-devel \
        fuse-devel \
        gtest-devel \
        libunwind-devel \
        openssl-devel \
        rpm-build \
        rubygem-json && \
    gem install fpm && \
    # Clean up dnf cache and temporary files to reduce image size
    dnf clean all && \
    rm -rf /var/cache/dnf /tmp/* /var/tmp/*

WORKDIR /polarfs
