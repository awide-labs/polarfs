FROM ubuntu:latest

# Install build dependencies and clean up in a single layer to reduce image size
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        make \
        git \
        ca-certificates \
        python3 \
        ruby-dev \
        libaio-dev \
        libboost-all-dev \
        libdouble-conversion-dev \
        libfmt-dev \
        libfuse-dev \
        libgoogle-glog-dev \
        libgtest-dev \
        libssl-dev && \
    gem install fpm && \
    # Build and install fast_float
    cd /tmp && \
    git clone --depth 1 https://github.com/fastfloat/fast_float.git && \
    cd fast_float && \
    mkdir build && cd build && \
    cmake .. -DFASTFLOAT_TEST=OFF && \
    cmake --build . -j$(nproc) && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/fast_float && \
    # Clean up apt cache and temporary files to reduce image size
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /polarfs
